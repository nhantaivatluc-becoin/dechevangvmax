.launch-notice{

position:fixed;

left:15px;

right:15px;

bottom:75px;


height:145px;


z-index:100;


background:

linear-gradient(

180deg,

rgba(5,5,5,.96),

rgba(15,15,5,.96)

);


border:

2px solid #ffd400;


border-radius:18px;


padding:12px;


box-shadow:

0 0 25px rgba(255,215,0,.8);


overflow:hidden;

}



.launch-notice h2{

margin:0;

text-align:center;

font-size:20px;

color:#ffd400;

}



.launch-notice p{

margin:2px;

text-align:center;

font-size:14px;

color:white;

}



.launch-notice hr{

border:none;

border-top:

1px solid #ffd400;

}



.notice-item{

font-size:13px;

line-height:18px;

}



.notice-item span{

color:#00ffcc;

font-weight:bold;

}



.notice-item small{

color:#ffd400;

}



.pin-btn{

position:absolute;

left:10px;

top:10px;


width:45px;

height:45px;


border-radius:50%;


border:

2px solid #ffd400;


background:#00e6c3;


font-size:22px;

}



.pin-btn-open{

position:fixed;

left:20px;

bottom:120px;


width:55px;

height:55px;


border-radius:50%;


background:#00e6c3;

border:2px solid #ffd400;

z-index:200;

}

