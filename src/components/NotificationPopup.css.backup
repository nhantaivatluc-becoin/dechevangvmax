.notification-popup{


position:fixed;


right:15px;


top:70px;


max-width:280px;


padding:15px 20px;


border-radius:20px;


background:

linear-gradient(

135deg,

#221500,

#000

);



color:#ffd700;


font-weight:bold;


border:1px solid gold;


box-shadow:

0 0 25px gold;


z-index:5000;


animation:

popupShow .5s ease;


}



@keyframes popupShow{


from{


opacity:0;


transform:translateX(100px);


}



to{


opacity:1;


transform:translateX(0);


}



}
