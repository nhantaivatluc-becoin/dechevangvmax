.launch-box{

position:fixed;

left:15px;

top:120px;

width:280px;

background:
linear-gradient(
145deg,
#160d00,
#000
);

border:

2px solid gold;

border-radius:20px;

padding:15px;

color:white;

z-index:4000;

overflow:hidden;

box-shadow:

0 0 30px gold;

animation:

boxGlow 3s infinite;

}


.launch-title{

text-align:center;

font-size:18px;

font-weight:bold;

color:#ffd700;

}



.running-text{

white-space:nowrap;

overflow:hidden;

color:white;

animation:

runText 12s linear infinite;

}



.game-rule{

margin-top:15px;

border-top:1px solid gold;

padding-top:10px;

}



@keyframes runText{

from{

transform:translateX(100%);

}

to{

transform:translateX(-100%);

}

}



@keyframes boxGlow{

50%{

box-shadow:

0 0 50px orange;

}

}
