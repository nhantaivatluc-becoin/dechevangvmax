.floating-panels{


position:fixed;


left:10px;


top:60px;


z-index:6000;


}



.pin-button{


position:fixed;


left:10px;


top:50px;


width:40px;


height:40px;


border-radius:50%;


background:#000;


border:2px solid gold;


color:gold;


font-size:20px;


z-index:7000;


}



.floating-mini{


position:fixed;


left:10px;


top:50px;


z-index:7000;


}




@media(max-width:600px){



.launch-box{


width:220px!important;


font-size:12px;


}



.notification-popup{


width:220px;


font-size:12px;


}




}



.left-cover-hide{

position:fixed;

left:0;

top:70px;

width:190px;

height:270px;

z-index:90;


background:

linear-gradient(

180deg,

rgba(0,0,0,.96),

rgba(10,10,5,.96)

);


border-radius:0 25px 25px 0;


box-shadow:

0 0 25px rgba(255,215,0,.35);


pointer-events:none;

}



